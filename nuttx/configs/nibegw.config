# Applied by build.sh on top of esp32c3-devkit:wifi.
#
# Nothing site specific is built in: Wi-Fi credentials and the host to
# forward to are set from NSH and saved in /data (see README.md).

# UART1 to the MAX485: TX GPIO5, RX GPIO6, DE/RE on GPIO4 (active high).
# The default UART1 pins GPIO8/9 are strapping pins.
CONFIG_ESPRESSIF_UART1=y
CONFIG_ESPRESSIF_UART1_TXPIN=5
CONFIG_ESPRESSIF_UART1_RXPIN=6
CONFIG_ESPRESSIF_UART1_RS485=y
CONFIG_ESPRESSIF_UART1_RS485_DIR_PIN=4
CONFIG_ESPRESSIF_UART1_RS485_DIR_POLARITY=1
CONFIG_UART1_BAUD=9600
CONFIG_SERIAL_TERMIOS=y

# Wi-Fi station with DHCP.  netinit loads the credentials saved with
# "wapi save_config wlan0"; the built-in SSID is empty.
CONFIG_NSH_NETINIT=y
CONFIG_NETINIT_THREAD=y
CONFIG_NETINIT_DHCPC=y
CONFIG_NETINIT_WAPI_SSID=""
CONFIG_NETINIT_WAPI_PASSPHRASE=""
CONFIG_WIRELESS_WAPI_INITCONF=y

# Name shown in the router's DHCP client list
CONFIG_LIBC_HOSTNAME="nibegw"
CONFIG_NETUTILS_DHCPC_HOST_NAME="nibegw"

# NSH over telnet for debugging once the board is at the heat pump
CONFIG_NETUTILS_TELNETD=y
CONFIG_SYSTEM_TELNETD=y
CONFIG_NSH_TELNET=y

# Hardware watchdog (/dev/watchdog0), fed by the gateway loop
CONFIG_ESPRESSIF_MWDT0=y

# The gateway, started together with NSH at boot
CONFIG_NIBEGW=y
CONFIG_NIBEGW_WATCHDOG=y
CONFIG_NIBEGW_BOOT=y
CONFIG_INIT_ENTRYPOINT="nibegwboot_main"
